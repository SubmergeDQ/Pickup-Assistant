<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_cainiao"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/open_cainiao"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_cainiao" />

    <ImageView
        android:id="@+id/widget_taobao"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/open_taobao"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_taobao" />

    <ImageView
        android:id="@+id/widget_pinduoduo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/open_pinduoduo"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_pinduoduo" />

    <ImageView
        android:id="@+id/widget_jd"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/open_jd"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_jd" />

    <ImageView
        android:id="@+id/widget_xhs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:contentDescription="@string/open_xhs"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brand_xhs" />

</LinearLayout>
