<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 与 Theme.bgTop 一致：深链模式不渲染界面，启动瞬间也不会闪出无关底色。 -->
        <item name="android:windowBackground">#F2D9D2</item>
        <!-- API 26 以下不支持深色导航栏图标，这里保持深色导航栏配白色图标。 -->
        <item name="android:navigationBarColor">#231A15</item>
        <item name="android:colorAccent">#231A15</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase" />

    <!-- 深色模式启动背景，与 Theme 深色渐变起点一致。 -->
    <style name="AppTheme.Dark" parent="AppTheme">
        <item name="android:windowBackground">#241F1C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
